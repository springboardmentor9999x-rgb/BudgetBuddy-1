# ==============================================================================
# BudgetBuddy Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET="budgetbuddy_ultra_secure_jwt_secret_key_2026"

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration for 6-Digit Email Verification
# ------------------------------------------------------------------------------
# To send verification codes directly to users' registered Gmail addresses:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com).
# 2. Go to Security > 2-Step Verification > App passwords.
# 3. Create a new App password named "BudgetBuddy" and paste the 16-character key below.
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Optional Custom SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM=BudgetBuddy <yourgmail@gmail.com>

# Gemini AI API Key (Optional)
GEMINI_API_KEY=""
