# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/budgetbuddy

# JWT Authentication
ALGORITHM=HS256
SECRET_KEY=generate_a_secure_random_key_here
REFRESH_TOKEN_SECRET_KEY=generate_another_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Settings (for OTP verification / notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDERS_EMAIL=your_email@gmail.com
GMAIL_PASSWORD=your_app_password
RESEND_API_KEY=your_resend_api_key_here
