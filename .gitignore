# ==========================================
# Budget Buddy - Git Ignore
# ==========================================

# ---------- SECRETS / ENVIRONMENT ----------
.env
.env.*
**/.env
**/.env.*
!.env.example
**/.env.example

# ---------- PRIVATE KEYS / CERTIFICATES ----------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ---------- PYTHON ----------
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# Python tooling/cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- FRONTEND / NODE ----------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/

# Vite local environment
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- LOGS ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- DATABASE / LOCAL DATA ----------
*.db
*.sqlite
*.sqlite3

# ---------- IDE / EDITOR ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OPERATING SYSTEM ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- TEMP / BACKUP FILES ----------
*.tmp
*.temp
*.bak
*.backup
*~